---
// Copy source: qualireps-v2/qualireps-audit/Landing page textes.md (validated
// 2026-10-30), sections 0 to 10. The exact rules live on /how-it-works.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PlatformInstall from '../components/PlatformInstall.astro';
import PaddlePrice from '../components/PaddlePrice.astro';
import { groupByChain } from '../lib/content';
import { SITE_ORIGIN } from '../lib/site';
import { FREE_FEATURES, PAID_FEATURES, OFFER_LOCKUP } from '../lib/offer';

import heroShot from '../assets/screenshots/01-dashboard.png';
import shotResting from '../assets/screenshots/03-exercise-resting.png';
import shotNewLoad from '../assets/screenshots/08-change-load.png';
import shotHistory from '../assets/screenshots/09-exercise-history.png';
import shotCustom from '../assets/screenshots/06-custom-exercise.png';

const entries = await getCollection('forms');
const chains = groupByChain(entries);

// Screenshots gallery — user-controlled strip. `alt` is a fuller description
// for assistive tech; `caption` is the short visible label. The hero shows 01,
// so the gallery starts at 03.
const shots = [
  { src: shotResting, caption: 'Rest set by effort', alt: 'Split Squat, Squat path Level 1 of 10: one set logged today (4 left, 4 right), next set 4 reps, state Resting with 02:50 left on the countdown; the Log set button is inactive, Log a past set stays available' },
  { src: shotNewLoad, caption: 'Your load, your call', alt: 'Set max for new load screen, moving to 62.5 kg: “How will you set your max?” with three choices — Use estimated max (suggested start: 8 reps), Already performed, or Test max now (starts a 24-hour test recovery)' },
  { src: shotHistory, caption: 'Every set, kept', alt: 'History screen: a Max evolution curve with a 16 kg and a 12 kg tab, measured and estimated points from 21 to 26 October 2026, then sessions by day — Today, Yesterday, 2 days ago, 5 days ago — with their sets and reps' },
  { src: shotCustom, caption: 'Your own exercises, with loads', alt: 'Custom exercise form: reps or seconds, bilateral or unilateral, With load set to 10 kg (kg or lb), and a passage criterion of 12 reps — “When your max reaches it, the app suggests a heavier load.”' },
];

const title = 'QualiReps — the strength ledger';
const description =
  'Every set, every max, every level, every load — kept on your phone. QualiReps sizes each set from your max, leaves you a margin, and shows when the next one is safe. Bodyweight paths, kettlebell and your own exercises. One exercise free; 9,99 € once.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'QualiReps',
    applicationCategory: 'HealthApplication',
    operatingSystem: 'Web, Android, iOS',
    offers: { '@type': 'Offer', price: '9.99', priceCurrency: 'EUR' },
    description,
    url: SITE_ORIGIN,
  },
];

const faqs = [
  {
    q: 'Can I try it before paying?',
    a: 'Yes. The free version runs on one active exercise, on any path, with every level of that path. Everything works on it: max tests, set sizes, rest, history, export and backup. To practice something else, archive it and start another.',
  },
  {
    q: 'What does the purchase add?',
    a: 'One exercise on every path at the same time, and as many exercises of your own as you want, with loads. <span data-paddle-price>9,99 €</span> once: a lifetime license, no subscription, no ads.',
  },
  {
    q: 'How do I pay, and use my other devices?',
    a: 'You pay once through Paddle, either from inside the app or <a href="/buy">on the web</a>. The license key is emailed to you, and in the app it is shown under Settings → License. On another device, tap “I have a license” or “Enter key →” and type the key. It is checked on the device; there is no account.',
  },
  {
    q: 'Does it work offline?',
    a: 'Yes, after the first load. The app’s files are cached on your device, and your data is stored there too. Purchasing is the exception: it needs a connection.',
  },
  {
    q: 'What data leaves my device?',
    a: 'In normal use, none. Your exercises, sets and maxes stay in your browser’s storage on the device. The app has no account, no ads, no analytics, no trackers and no third-party fonts. Buying is the one exception: the app loads Paddle’s checkout, where you type your email; our server then receives the Paddle transaction id, fetches your email from Paddle and sends you the license key through an email provider, Resend. This website is different from the app: it counts visits with GoatCounter, and some pages load Paddle’s script to show the price in your currency. See the <a href="/privacy">privacy policy</a>.',
  },
  {
    q: 'What if I lose or replace my phone?',
    a: 'Your data lives only on the device, so keep a backup. Settings → Data → “Export backup” writes a JSON file with everything, including your license key; the file is not encrypted, so keep it somewhere safe. “Import backup” on another device replaces that device’s data with the file’s. The app reminds you after 30 days without a backup.',
  },
  {
    q: 'Strength or muscle?',
    a: 'Each exercise has a focus. Strength keeps sets short and far from failure. Muscle brings each set closer to your max, which is where muscle grows. Both always leave you a margin, and you can switch at any time without a new test.',
  },
  {
    q: 'Is this Greasing the Groove?',
    a: 'It can be. Greasing the Groove means practicing a movement in short sets spread through the day, well short of failure. QualiReps keeps the ledger for that, and for sets done back to back in a session.',
  },
];
---

<Base title={title} description={description} path="/" jsonLd={jsonLd}>
  <!-- ───────────── 0 · OPENING ───────────── -->
  <section class="hero">
    <div class="wrap">
      <div class="hero-grid">
        <div class="hero-copy">
          <div class="eyebrow hero-eyebrow">A strength ledger · v1.0</div>
          <h1>The strength ledger.</h1>
          <p class="hero-sub">
            Every set, every max, every level, every load — kept on your phone.
            QualiReps sizes each set from your max, leaves you a margin, and
            shows when the next one is safe. It never tells you what to train.
          </p>
          <div class="hero-cta-row">
            <a href="#install" class="btn btn-primary">Install QualiReps — free</a>
            <a href="/how-it-works" class="btn btn-ghost">How it works</a>
          </div>
          <a href="/pricing" class="hero-price">
            <span class="lead-in">Lifetime license —</span>
            <span class="amount" data-paddle-price>9,99 €</span>
            <span class="terms">· pay once, like a book. No account, no ads, no subscription.</span>
          </a>

          <div class="hero-meta">
            <div class="item">
              <span class="k">Train</span>
              <span class="v">Bodyweight paths · Kettlebell · Your own exercises</span>
            </div>
            <div class="item">
              <span class="k">Platform</span>
              <span class="v">Web app · Android, iOS, desktop</span>
            </div>
            <div class="item">
              <span class="k">Pricing</span>
              <span class="v">One exercise free · <span data-paddle-price>9,99 €</span> once</span>
            </div>
          </div>
        </div>

        <div class="phone-stage">
          <div class="phone">
            <div class="phone-screen">
              <Image
                class="phone-shot"
                src={heroShot}
                alt="QualiReps home screen: six exercises listed by availability, each with its next set, rest countdown or recovery."
                widths={[320, 480, 640]}
                sizes="(max-width: 880px) 280px, 320px"
                format="webp"
                loading="eager"
                fetchpriority="high"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────────── 1 · WHAT IT KEEPS ───────────── -->
  <section class="for-who">
    <div class="wrap inner">
      <div>
        <div class="eyebrow" style="margin-bottom:24px">01 / The ledger</div>
        <h2>What it keeps.</h2>
      </div>
      <div>
        <p>
          Your max for each exercise, and the date you set it. Every set you
          log, with its reps or seconds, its load and its time — including the
          sets you forgot to log and add later. Every level change, every load
          change. History by exercise and by day, a curve of your maxes, CSV
          export and a full backup file.
        </p>
        <p>
          It is a notebook that does the arithmetic. Nothing leaves your phone.
        </p>
      </div>
    </div>
  </section>

  <!-- ───────────── 2 · WHAT IT WORKS OUT ───────────── -->
  <section id="method" class="section-divider">
    <div class="wrap">
      <div class="two-col">
        <div class="col-head">
          <div class="eyebrow" style="margin-bottom:24px">02 / The arithmetic</div>
          <h2>What it works out.</h2>
        </div>
        <div class="body">
          <div class="principles">
            <div class="p"><span class="n">01</span><div><span class="t">The next set.</span><span class="d">Sized from your max, with the focus you choose for each exercise: short, crisp sets for strength, or longer sets closer to your max for muscle. Always at least two reps short of your max. You finish every set with something left.</span></div></div>
            <div class="p"><span class="n">02</span><div><span class="t">The rest.</span><span class="d">The harder the set felt, the longer the wait: two, three or five minutes. A set taken to your max ends that exercise for the day.</span></div></div>
            <div class="p"><span class="n">03</span><div><span class="t">The recovery.</span><span class="d">After a max test, that exercise rests for 24 hours. Your other exercises are not affected.</span></div></div>
          </div>
          <p class="after-grid">
            The next set button stays off until the rest is over. The rules are
            written down, the same every day:
            <a href="/how-it-works" class="inline-link">How it works →</a>
          </p>
          <p class="closing">
            QualiReps never tells you what to train. It tells you when the next
            set is safe.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────────── 3 · WHAT YOU TRAIN ───────────── -->
  <section id="train" class="section-divider">
    <div class="wrap">
      <div class="features-head">
        <div>
          <div class="eyebrow" style="margin-bottom:24px">03 / Exercises</div>
          <h2>What you train.</h2>
        </div>
      </div>

      <div class="cols cols-3">
        <div class="panel">
          <h3>Bodyweight paths</h3>
          <p>
            Push-up, pull-up and squat, each a ladder of harder variations —
            from a push-up against the wall to the one-arm push-up, from a dead
            hang to the one-arm pull-up, from a split squat to the free pistol.
            Each level has a passage criterion; you decide when to move.
          </p>
        </div>
        <div class="panel">
          <h3>Kettlebell press</h3>
          <p>
            One movement, your bell. Set the weight you own; change it when you
            choose.
          </p>
        </div>
        <div class="panel">
          <h3>Your own exercises</h3>
          <p>
            Anything outside the paths, with a load if it has one — dumbbells, a
            barbell, a machine. Kilograms or pounds.
          </p>
        </div>
      </div>

      <p class="lockup">One exercise per path at a time, and as many of your own as you like.</p>
    </div>
  </section>

  <!-- ───────────── 4 · YOUR WAY ───────────── -->
  <section class="for-who">
    <div class="wrap inner">
      <div>
        <div class="eyebrow" style="margin-bottom:24px">04 / Practice</div>
        <h2>Your way.</h2>
      </div>
      <div>
        <p>
          Train for strength, for muscle, or both: each exercise has its own
          focus, and you can switch it at any time. Spread short sets through
          the day, or do them back to back in one session. Rest is counted
          exercise by exercise, so you can alternate two movements while each
          one rests.
        </p>
        <p>
          Spreading sets through the day has a name: <em>Greasing the
          Groove</em>. QualiReps works well for it, and for anything else built
          on sets and rest.
        </p>
      </div>
    </div>
  </section>

  <!-- ───────────── 5 · CALM BY DESIGN ───────────── -->
  <section id="calm" class="section-divider">
    <div class="wrap">
      <div class="two-col">
        <div class="col-head">
          <div class="eyebrow" style="margin-bottom:24px">05 / Principles</div>
          <h2>Calm by design.</h2>
        </div>
        <div class="body">
          <p>
            QualiReps follows the principles of calm technology: ask for as
            little attention as possible, inform without pushing.
          </p>
          <ul class="dash-list">
            <li>No account, no email, no password.</li>
            <li>Your data stays on your phone, and the app works offline.</li>
            <li>No ads, no tracking in the app.</li>
            <li>No badges, no streaks, no messages telling you to do more.</li>
            <li>Pay once, like a book. No subscription.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────────── 6 · FREE AND PAID ───────────── -->
  <section id="demo" class="section-divider">
    <div class="wrap">
      <div class="features-head">
        <div>
          <div class="eyebrow" style="margin-bottom:24px">06 / Pricing</div>
          <h2>Free and paid.</h2>
        </div>
      </div>

      <div class="cols">
        <div class="panel">
          <h3>Free</h3>
          <ul>
            {FREE_FEATURES.map((f) => <li>{f}</li>)}
          </ul>
        </div>
        <div class="panel">
          <h3>Paid · <span data-paddle-price>9,99 €</span> once</h3>
          <ul>
            {PAID_FEATURES.map((f) => <li>{f}</li>)}
          </ul>
        </div>
      </div>

      <p class="lockup">{OFFER_LOCKUP}</p>
    </div>
  </section>

  <!-- ───────────── 7 · SEE IT ───────────── -->
  <section id="screenshots" class="section-divider">
    <div class="wrap">
      <div class="features-head">
        <div>
          <div class="eyebrow" style="margin-bottom:24px">07 / Screenshots</div>
          <h2>See it.</h2>
        </div>
      </div>

      <ul class="shots" role="list">
        {
          shots.map((shot) => (
            <li class="shot">
              <div class="shot-frame">
                <Image
                  class="shot-img"
                  src={shot.src}
                  alt={shot.alt}
                  widths={[240, 360, 480]}
                  sizes="(max-width: 760px) 60vw, 220px"
                  format="webp"
                  loading="lazy"
                />
              </div>
              <span class="shot-cap">{shot.caption}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ───────────── 8 · INSTALL ───────────── -->
  <section id="install" class="section-divider">
    <div class="wrap">
      <div class="features-head">
        <div>
          <div class="eyebrow" style="margin-bottom:24px">08 / Get QualiReps</div>
          <h2>Install.</h2>
        </div>
        <p class="lead">
          Install free from your browser. Android, desktop and iOS run the same
          web app; after the first load it works offline, except for
          purchasing.
        </p>
      </div>
      <PlatformInstall />
    </div>
  </section>

  <!-- ───────────── 9 · FORM GUIDES ───────────── -->
  <section id="forms" class="section-divider">
    <div class="wrap">
      <div class="features-head">
        <div>
          <div class="eyebrow" style="margin-bottom:24px">09 / Form guides</div>
          <h2>Form guides.</h2>
        </div>
        <p class="lead">
          One guide for every level of the bodyweight paths, and one for the
          kettlebell press: set-up, the rep, what to watch for. Free to read,
          here and in the app.
        </p>
      </div>

      <div class="chain-grid">
        {
          chains.map((chain) => (
            <a class="chain-card" href="/forms">
              <span class="chain-card__name">{chain.name}</span>
              <span class="chain-card__count">
                {chain.fiches.length}
                {chain.fiches.length > 1 ? ' guides' : ' guide'}
              </span>
            </a>
          ))
        }
      </div>
      <p class="forms-link">
        <a href="/forms" class="btn btn-ghost">Browse all form guides →</a>
      </p>
    </div>
  </section>

  <!-- ───────────── 10 · QUESTIONS ───────────── -->
  <section id="faq" class="section-divider">
    <div class="wrap">
      <div class="features-head faq-head">
        <div>
          <div class="eyebrow" style="margin-bottom:24px">10 / Frequently asked</div>
          <h2>Questions.</h2>
        </div>
      </div>
      <div class="faq">
        {
          faqs.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <div class="answer" set:html={item.a} />
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <PaddlePrice />
</Base>

<style>
  /* ───── HERO ───── */
  .hero {
    padding: clamp(48px, 7vw, 96px) 0 clamp(64px, 8vw, 110px);
    position: relative;
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(40px, 6vw, 72px);
    align-items: center;
  }
  .hero-eyebrow {
    margin-bottom: 28px;
  }
  .hero h1 {
    margin-bottom: 26px;
    max-width: 14ch;
  }
  .hero-sub {
    font-size: clamp(16px, 1.45vw, 19px);
    color: var(--fg-mute);
    max-width: 52ch;
    line-height: 1.6;
    margin-bottom: 36px;
  }
  .hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
    margin-bottom: 22px;
  }
  .hero-price {
    display: inline-flex;
    align-items: baseline;
    flex-wrap: wrap;
    column-gap: 12px;
    row-gap: 2px;
    text-decoration: none;
  }
  .hero-price .lead-in {
    font-size: 15px;
    color: var(--fg);
  }
  .hero-price .amount {
    font-family: var(--font-display);
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--accent);
    transition: color 0.15s ease;
  }
  .hero-price:hover .amount {
    color: var(--accent-hi);
  }
  .hero-price .terms {
    font-size: 13px;
    color: var(--fg-mute);
  }
  .hero-meta {
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid var(--hairline-soft);
    display: flex;
    flex-wrap: wrap;
    gap: clamp(20px, 3vw, 44px);
  }
  .hero-meta .item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .hero-meta .k {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-dim);
  }
  .hero-meta .v {
    font-size: 14px;
    color: var(--fg);
  }

  .phone-stage {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }
  .phone-stage::before {
    content: '';
    position: absolute;
    inset: 10% -10% 10% -10%;
    background: radial-gradient(
      closest-side,
      rgba(217, 144, 74, 0.1),
      transparent 70%
    );
    filter: blur(20px);
    z-index: 0;
    pointer-events: none;
  }
  .phone {
    position: relative;
    z-index: 1;
    width: min(320px, 100%);
    background: #0e0c0b;
    border-radius: 44px;
    padding: 12px;
    box-shadow: 0 0 0 1px #2a2622 inset, 0 30px 60px -20px rgba(0, 0, 0, 0.7),
      0 10px 30px -10px rgba(0, 0, 0, 0.5);
    border: 1px solid #2a2622;
  }
  .phone-screen {
    /* Exactly the screenshot's ratio, so the whole image fits uncropped.
       The phone's height follows from it (no fixed ratio on .phone). */
    width: 100%;
    aspect-ratio: 1080 / 2177;
    background: linear-gradient(180deg, #1c1a18 0%, #161412 100%);
    border-radius: 32px;
    overflow: hidden;
  }
  .phone-shot {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  @media (max-width: 880px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }

  /* ───── TWO-COL ───── */
  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: clamp(32px, 6vw, 88px);
    align-items: start;
  }
  .two-col .col-head h2 {
    margin-bottom: 16px;
  }
  .two-col .body p {
    color: var(--fg);
    font-size: 17px;
    line-height: 1.7;
    margin-bottom: 18px;
  }
  .two-col .body p :global(em) {
    color: var(--accent-hi);
    font-style: italic;
  }
  .two-col .body p.after-grid {
    margin-top: 28px;
    color: var(--fg-mute);
    font-size: 15px;
  }
  .two-col .body p.closing {
    margin-top: 28px;
    font-family: var(--font-display);
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.4;
    letter-spacing: -0.01em;
  }
  .inline-link {
    color: var(--accent-hi);
    white-space: nowrap;
  }
  .principles {
    border-top: 1px solid var(--hairline-soft);
  }
  .principles .p {
    padding: 18px 0;
    border-bottom: 1px solid var(--hairline-soft);
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .principles .n {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--accent);
    font-weight: 600;
    padding-top: 3px;
    min-width: 22px;
  }
  .principles .t {
    font-weight: 600;
    font-size: 15px;
    color: var(--fg);
    display: block;
    margin-bottom: 4px;
  }
  .principles .d {
    color: var(--fg-mute);
    font-size: 15px;
    line-height: 1.6;
  }
  .dash-list {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    border-top: 1px solid var(--hairline-soft);
  }
  .dash-list li {
    position: relative;
    padding: 14px 0 14px 1.5rem;
    border-bottom: 1px solid var(--hairline-soft);
    color: var(--fg);
    font-size: 16px;
    line-height: 1.5;
  }
  .dash-list li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--accent);
  }
  @media (max-width: 760px) {
    .two-col {
      grid-template-columns: 1fr;
    }
  }

  /* ───── WHO (for-who) ───── */
  .for-who {
    background: var(--bg-deep);
    border-top: 1px solid var(--hairline-soft);
    border-bottom: 1px solid var(--hairline-soft);
  }
  .for-who .inner {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
  }
  .for-who p {
    font-size: clamp(18px, 1.7vw, 22px);
    line-height: 1.55;
    color: var(--fg);
  }
  .for-who p + p {
    margin-top: 18px;
    color: var(--fg-mute);
    font-size: clamp(16px, 1.4vw, 18px);
  }
  .for-who p :global(em) {
    color: var(--accent-hi);
    font-style: italic;
  }
  .for-who + .for-who {
    border-top: 0;
  }
  @media (max-width: 760px) {
    .for-who .inner {
      grid-template-columns: 1fr;
    }
  }

  /* ───── shared section head ───── */
  .features-head {
    display: flex;
    justify-content: space-between;
