---
// Copy source: AUDIT-2026-10-15.md (repo root). Every factual statement on
// this page traces to a section of that audit; vocabulary follows its
// section 9 (the app's own words on screen).
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PlatformInstall from '../components/PlatformInstall.astro';
import PaddlePrice from '../components/PaddlePrice.astro';
import { groupByChain } from '../lib/content';
import { SITE_ORIGIN, APP_URL, APP_HOST } from '../lib/site';

// 01 (dashboard) and 03 (resting) are not used: they show a 15-minute rest
// on an exercise created before the 5-minute default.
import heroShot from '../assets/screenshots/02-exercise-fresh.png';
import shotRecovery from '../assets/screenshots/04-exercise-recovery.png';
import shotTestMax from '../assets/screenshots/05-test-max.png';
import shotCustom from '../assets/screenshots/06-custom-exercise.png';
import shotChainPicker from '../assets/screenshots/07-chain-picker.png';

const entries = await getCollection('forms');
const chains = groupByChain(entries);

// Screenshots gallery — user-controlled strip. `alt` is a fuller description
// for assistive tech; `caption` is the short visible label.
const shots = [
  { src: shotChainPicker, caption: 'Choose a path', alt: 'New exercise screen: Push-up path 16 levels, Pull-up path 12 levels, Squat path 10 levels, Kettlebell press path 11 levels, and Create a custom exercise' },
  { src: shotTestMax, caption: 'Test your max', alt: 'Test max now screen: a clean reps stepper and the line “Saving this triggers 24-hour CNS recovery.”' },
  { src: shotRecovery, caption: 'Recovery after a max test', alt: 'Standard Pull-Up, Pull-up path Level 7 of 12: state Recovery, with a 24-hour countdown' },
  { src: shotCustom, caption: 'A custom exercise', alt: 'Custom exercise form: exercise name, unit (reps or seconds), symmetry (bilateral or unilateral)' },
];

const title = 'QualiReps — a strength ledger for daily practice';
const description =
  'A ledger for practising one movement often, in sets well short of failure. QualiReps records your max, computes the dose for each set, shows when the next set is due, and tracks your level on four progression paths. Free on one exercise; 9,99 € once to change level, keep up to three exercises active and create custom ones.';

// The only home-page occurrence of the term outside the FAQ (kept for search).
const methodParagraph =
  'QualiReps is built around one practice: a single movement, done in several short sets spread through the day, each set stopped well short of failure. The practice is known as <em>Greasing the Groove</em>; on screen, the app calls it GtG. QualiReps keeps the ledger for it, exercise by exercise.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'QualiReps',
    applicationCategory: 'HealthApplication',
    operatingSystem: 'Web, Android, iOS',
    offers: { '@type': 'Offer', price: '9.99', priceCurrency: 'EUR' },
    description,
    url: SITE_ORIGIN,
  },
];

const faqs = [
  {
    q: 'Can I try QualiReps before paying?',
    a: 'Yes. The free version runs on one exercise, on any path and at any level, and that exercise stays at its level. Max testing, the dose, the four states, set logging, history, the form guides, CSV export and backup all work on it. You can change your choice of exercise once. Changing level, adding exercises and creating custom exercises are paid.',
  },
  {
    q: 'What does the purchase add?',
    a: 'Three things: changing level, up or down, on any exercise; up to three active exercises at a time, at most one per path; and custom exercises, for movements outside the paths. The limit of three active exercises applies to paid users too. The price is <span data-paddle-price>9,99 €</span>, paid once: a lifetime license, no subscription.',
  },
  {
    q: 'How do I pay, and how do I use my other devices?',
    a: 'You pay once through Paddle, either from inside the app or <a href="/buy">on the web</a>. The license key is emailed to you, and in the app it is shown under Settings → License. On another device, tap “I have a license” or “Enter key →” and type the key. It is checked on the device; there is no account.',
  },
  {
    q: 'How do I install QualiReps?',
    a: `From the browser; there is no app store. On Android and desktop, open <a href="${APP_URL}">${APP_HOST}</a> in Chrome (or Edge on desktop) and use its install button. On iPhone and iPad, open <a href="${APP_URL}">${APP_HOST}</a> in Safari, tap Share, then “Add to Home Screen”.`,
  },
  {
    q: 'Does it work offline?',
    a: 'Yes, after the first load. The app’s files are cached on your device, and your data is stored there too. Purchasing is the exception: it needs a connection.',
  },
  {
    q: 'What data leaves my device?',
    a: 'In normal use, none. Your exercises, sets and maxes stay in your browser’s storage on the device. The app has no account, no analytics, no trackers and no third-party fonts. Buying is the one exception: the app loads Paddle’s checkout, where you type your email; our server then receives the Paddle transaction id, fetches your email from Paddle and sends you the license key through an email provider, Resend. This website is different from the app: it counts visits with GoatCounter, and some pages load Paddle’s script to show the price in your currency. See the <a href="/privacy">privacy policy</a>.',
  },
  {
    q: 'What if I lose or replace my phone?',
    a: 'Your data lives only on the device, so keep a backup. Settings → Data → “Export backup” writes a JSON file with everything, including your license key; the file is not encrypted, so keep it somewhere safe. “Import backup” on another device replaces that device’s data with the file’s. The app reminds you after 30 days without a backup.',
  },
  {
    q: 'What is Greasing the Groove?',
    a: 'A way of practising one movement: several short sets through the day, each stopped well short of failure, with rest between sets. QualiReps implements it with the mechanics on this page: the dose comes from your max, the next set waits for the rest to end, and a level change waits for you, once the passage criterion is reached.',
  },
];
---

<Base title={title} description={description} path="/" jsonLd={jsonLd}>
  <!-- ───────────── HERO ───────────── -->
  <section class="hero">
    <div class="wrap">
      <div class="hero-grid">
        <div class="hero-copy">
          <div class="eyebrow hero-eyebrow">A strength practice ledger · v1.0</div>
          <h1>A strength ledger for daily practice.</h1>
          <p class="hero-sub">
            Practise one movement often, in sets well short of failure.
            QualiReps records your max, computes the dose for each set, shows
            when the next set is due, and tracks your level along a path of
            harder variations.
          </p>
          <div class="hero-cta-row">
            <a href="#install" class="btn btn-primary">Install QualiReps — free</a>
            <a href="#method" class="btn btn-ghost">How it works</a>
          </div>
          <a href="/pricing" class="hero-price">
            <span class="lead-in">Lifetime license —</span>
            <span class="amount" data-paddle-price>9,99 €</span>
            <span class="terms">· one purchase, no subscription</span>
          </a>

          <div class="hero-meta">
            <div class="item">
              <span class="k">Paths</span>
              <span class="v">Push-up · Pull-up · Squat · Kettlebell press</span>
            </div>
            <div class="item">
              <span class="k">Platform</span>
              <span class="v">Web app · Android, iOS, desktop</span>
            </div>
            <div class="item">
              <span class="k">Pricing</span>
              <span class="v">Free on one exercise · <span data-paddle-price>9,99 €</span> once</span>
            </div>
          </div>
        </div>

        <div class="phone-stage">
          <div class="phone">
            <div class="phone-screen">
              <Image
                class="phone-shot"
                src={heroShot}
                alt="Exercise screen for Split Squat, Squat path Level 1 of 10: state Fresh, next set 4 reps"
                widths={[320, 480, 640]}
                sizes="(max-width: 880px) 280px, 320px"
                format="webp"
                loading="eager"
                fetchpriority="high"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────────── 01 · HOW IT WORKS ───────────── -->
  <section id="method" class="section-divider">
    <div class="wrap">
      <div class="two-col">
        <div class="col-head">
          <div class="eyebrow" style="margin-bottom:24px">01 / How it works</div>
          <h2>Max, dose, rest, level.</h2>
          <p class="lead" style="margin-top:18px">
            What QualiReps keeps for each exercise, and what it shows you.
          </p>
        </div>
        <div class="body">
          <p set:html={methodParagraph}></p>
          <div class="gtg-principles">
            <div class="p"><span class="n">01</span><div><span class="t">Max</span><span class="d">Your max in clean reps or clean seconds: performed now, already performed, or estimated. It changes only when you update it.</span></div></div>
            <div class="p"><span class="n">02</span><div><span class="t">Dose</span><span class="d">NEXT SET shows half your max, rounded down, capped at 5 reps and never below 1. Timed holds get half the max, with no cap. One-sided exercises are dosed from the weaker side.</span></div></div>
            <div class="p"><span class="n">03</span><div><span class="t">Rest</span><span class="d">After a set, the exercise is Resting, with a countdown, for at least 5 minutes — longer after a set close to failure. Its Log set button stays disabled until it is Fresh again.</span></div></div>
            <div class="p"><span class="n">04</span><div><span class="t">Level</span><span class="d">Each level has a passage criterion. When your max reaches it, the exercise screen says so and offers Change level. Moving is never automatic.</span></div></div>
          </div>
          <p class="after-grid">
            A measured max test puts that exercise into Recovery for 24 hours;
            an estimated max does not, and your other exercises are unaffected.
            On the days you switch off under Settings → Active days (Sunday, by
            default), every exercise shows Rest day and its set button is
            disabled.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────────── 02 · THE PATHS ───────────── -->
  <section class="for-who">
    <div class="wrap inner">
      <div>
        <div class="eyebrow" style="margin-bottom:24px">02 / The paths</div>
        <h2>Four paths of harder variations.</h2>
      </div>
      <div>
        <p>
          Each path is a ladder of levels, with a passage criterion per level.
          The push-up, pull-up and squat paths make each level harder through
          leverage. The kettlebell press path keeps one movement, a one-arm
          clean and press, and makes it harder by weight.
        </p>
        <p>
          Push-up path: 16 levels. Pull-up path: 12 levels. Squat path: 10
          levels. Kettlebell press path: 11 levels, from 8 kg to 48 kg in 4 kg
          steps. You choose the level you start at, and you can keep one active
          exercise per path. For a movement outside the paths, a paid license
          adds custom exercises.
        </p>
      </div>
    </div>
  </section>

  <!-- ───────────── 03 · FREE AND PAID ───────────── -->
  <section id="demo" class="section-divider">
    <div class="wrap">
      <div class="features-head">
        <div>
          <div class="eyebrow" style="margin-bottom:24px">03 / Free and paid</div>
          <h2>Free on one exercise.</h2>
        </div>
        <p class="lead">
          The free version runs the whole ledger, on one exercise.
        </p>
      </div>

      <div class="demo-body">
        <p>
          You pick one exercise, on any path, at any level. It stays at that
          level, and everything else works on it: max testing, the dose, the
          four states, set logging, history, the form guides, CSV export and
          backup.
        </p>
        <p>
          You can change that choice once. After that it is fixed: archiving or
          deleting the exercise does not open a new choice, and neither does
          Reset all data. When you reach the passage criterion, the app still
          shows it; changing level is part of the paid version.
        </p>
      </div>

      <div class="cols">
        <div class="panel">
          <h3>Free</h3>
          <ul>
            <li>One exercise, on any path and at any level, fixed at that level</li>
            <li>One change of that choice</li>
            <li>Max testing, dose, the four states, set logging</li>
            <li>History, CSV export, backup</li>
            <li>All 39 form guides</li>
          </ul>
        </div>
        <div class="panel">
          <h3>Paid · <span data-paddle-price>9,99 €</span> once</h3>
          <ul>
            <li>Change level, up or down, at any time</li>
            <li>Up to three active exercises, at most one per path</li>
            <li>Custom exercises, for movements outside the paths</li>
            <li>One license key for your other devices</li>
          </ul>
        </div>
      </div>

      <p class="lockup">One purchase, lifetime license. No subscription.</p>
    </div>
  </section>

  <!-- ───────────── 04 · SCREENSHOTS ───────────── -->
  <section id="screenshots" class="section-divider">
    <div class="wrap">
      <div class="features-head">
        <div>
          <div class="eyebrow" style="margin-bottom:24px">04 / Screenshots</div>
          <h2>See it.</h2>
        </div>
        <p class="lead">
          The paths, the max test, the Recovery state that follows it, and a
          custom exercise.
        </p>
      </div>

      <ul class="shots" role="list">
        {
          shots.map((shot) => (
            <li class="shot">
              <div class="shot-frame">
                <Image
                  class="shot-img"
                  src={shot.src}
                  alt={shot.alt}
                  widths={[240, 360, 480]}
                  sizes="(max-width: 760px) 60vw, 220px"
                  format="webp"
                  loading="lazy"
                />
              </div>
              <span class="shot-cap">{shot.caption}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ───────────── 05 · GET QUALIREPS ───────────── -->
  <section id="install" class="section-divider">
    <div class="wrap">
      <div class="features-head">
        <div>
          <div class="eyebrow" style="margin-bottom:24px">05 / Get QualiReps</div>
          <h2>Install.</h2>
        </div>
        <p class="lead">
          Install free from your browser. Android, desktop and iOS run the same
          web app; after the first load it works offline, except for
          purchasing.
        </p>
      </div>
      <PlatformInstall />
    </div>
  </section>

  <!-- ───────────── 06 · PERFECT FORM GUIDES ───────────── -->
  <section id="forms" class="section-divider">
    <div class="wrap">
      <div class="features-head">
        <div>
          <div class="eyebrow" style="margin-bottom:24px">06 / Perfect form guides</div>
          <h2>Open knowledge.</h2>
        </div>
        <p class="lead">
          39 perfect form guides: one for each of the 38 bodyweight levels, and
          one shared by all 11 kettlebell levels. They are free to read, here
          and in the app.
        </p>
      </div>

      <div class="chain-grid">
        {
          chains.map((chain) => (
            <a class="chain-card" href="/forms">
              <span class="chain-card__name">{chain.name}</span>
              <span class="chain-card__count">
                {chain.fiches.length}
                {chain.fiches.length > 1 ? ' guides' : ' guide'}
              </span>
            </a>
          ))
        }
      </div>
      <p class="forms-link">
        <a href="/forms" class="btn btn-ghost">Browse all form guides →</a>
      </p>
    </div>
  </section>

  <!-- ───────────── 07 · FAQ ───────────── -->
  <section id="faq" class="section-divider">
    <div class="wrap">
      <div class="features-head faq-head">
        <div>
          <div class="eyebrow" style="margin-bottom:24px">07 / Frequently asked</div>
          <h2>Questions.</h2>
        </div>
      </div>
      <div class="faq">
        {
          faqs.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <div class="answer" set:html={item.a} />
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <PaddlePrice />
</Base>

<style>
  /* ───── HERO ───── */
  .hero {
    padding: clamp(48px, 7vw, 96px) 0 clamp(64px, 8vw, 110px);
    position: relative;
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(40px, 6vw, 72px);
    align-items: center;
  }
  .hero-eyebrow {
    margin-bottom: 28px;
  }
  .hero h1 {
    margin-bottom: 26px;
    max-width: 14ch;
  }
  .hero-sub {
    font-size: clamp(16px, 1.45vw, 19px);
    color: var(--fg-mute);
    max-width: 52ch;
    line-height: 1.6;
    margin-bottom: 36px;
  }
  .hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
    margin-bottom: 22px;
  }
  .hero-price {
    display: inline-flex;
    align-items: baseline;
    flex-wrap: wrap;
    column-gap: 12px;
    row-gap: 2px;
    text-decoration: none;
  }
  .hero-price .lead-in {
    font-size: 15px;
    color: var(--fg);
  }
  .hero-price .amount {
    font-family: var(--font-display);
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--accent);
    transition: color 0.15s ease;
  }
  .hero-price:hover .amount {
    color: var(--accent-hi);
  }
  .hero-price .terms {
    font-size: 13px;
    color: var(--fg-mute);
  }
  .hero-meta {
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid var(--hairline-soft);
    display: flex;
    flex-wrap: wrap;
    gap: clamp(20px, 3vw, 44px);
  }
  .hero-meta .item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .hero-meta .k {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-dim);
  }
  .hero-meta .v {
    font-size: 14px;
    color: var(--fg);
  }

  .phone-stage {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }
  .phone-stage::before {
    content: '';
    position: absolute;
    inset: 10% -10% 10% -10%;
    background: radial-gradient(
      closest-side,
      rgba(217, 144, 74, 0.1),
      transparent 70%
    );
    filter: blur(20px);
    z-index: 0;
    pointer-events: none;
  }
  .phone {
    position: relative;
    z-index: 1;
    width: min(320px, 100%);
    aspect-ratio: 430 / 932;
    background: #0e0c0b;
    border-radius: 44px;
    padding: 12px;
    box-shadow: 0 0 0 1px #2a2622 inset, 0 30px 60px -20px rgba(0, 0, 0, 0.7),
      0 10px 30px -10px rgba(0, 0, 0, 0.5);
    border: 1px solid #2a2622;
  }
  .phone-screen {
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, #1c1a18 0%, #161412 100%);
    border-radius: 32px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .phone-shot {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Anchor to the top so the dark top margin (corner clearance) is what
       the rounded frame clips — never the app's top-corner icons. The
       bottom of the screenshot overflows and is clipped instead. */
    object-position: top;
    display: block;
    border-radius: 32px;
  }
  @media (max-width: 880px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }

  /* ───── TWO-COL (GtG) ───── */
  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: clamp(32px, 6vw, 88px);
    align-items: start;
  }
  .two-col .col-head h2 {
    margin-bottom: 16px;
  }
  .two-col .body p {
    color: var(--fg);
    font-size: 17px;
    line-height: 1.7;
    margin-bottom: 18px;
  }
  .two-col .body p :global(em) {
    color: var(--accent-hi);
    font-style: italic;
  }
  .two-col .body p.after-grid {
    margin-top: 28px;
    color: var(--fg-mute);
    font-size: 15px;
  }
  .gtg-principles {
    margin-top: 28px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--hairline-soft);
  }
  .gtg-principles .p {
    padding: 18px 0;
    border-bottom: 1px solid var(--hairline-soft);
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .gtg-principles .p:nth-child(odd) {
    padding-right: 24px;
    border-right: 1px solid var(--hairline-soft);
  }
  .gtg-principles .p:nth-child(even) {
    padding-left: 24px;
  }
  .gtg-principles .n {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--accent);
    font-weight: 600;
    padding-top: 3px;
    min-width: 22px;
  }
  .gtg-principles .t {
    font-weight: 600;
    font-size: 15px;
    color: var(--fg);
    display: block;
    margin-bottom: 4px;
  }
  .gtg-principles .d {
    color: var(--fg-mute);
    font-size: 14px;
    line-height: 1.55;
  }
  @media (max-width: 760px) {
    .two-col {
      grid-template-columns: 1fr;
    }
    .gtg-principles {
      grid-template-columns: 1fr;
    }
    .gtg-principles .p:nth-child(odd) {
      padding-right: 0;
      border-right: 0;
    }
    .gtg-principles .p:nth-child(even) {
      padding-left: 0;
    }
  }

  /* ───── WHO (for-who) ───── */
  .for-who {
    background: var(--bg-deep);
    border-top: 1px solid var(--hairline-soft);
    border-bottom: 1px solid var(--hairline-soft);
  }
  .for-who .inner {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
  }
  .for-who p {
    font-size: clamp(18px, 1.7vw, 22px);
    line-height: 1.55;
    color: var(--fg);
  }
  .for-who p + p {
    margin-top: 18px;
    color: var(--fg-mute);
    font-size: clamp(16px, 1.4vw, 18px);
  }
  @media (max-width: 760px) {
    .for-who .inner {
      grid-template-columns: 1fr;
    }
  }

  /* ───── shared section head ───── */
  .features-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    margin-bottom: 48px;
    flex-wrap: wrap;
  }
  .features-head h2 {
    max-width: 16ch;
  }
  .features-head .lead {
    max-width: 38ch;
  }

  /* ───── DEMO ───── */
  .demo-body {
    max-width: 65ch;
    margin-bottom: 32px;
  }
  .demo-body p {
    color: var(--fg);
    font-size: 17px;
    line-height: 1.7;
  }
  .demo-body p + p {
    margin-top: 16px;
    color: var(--fg-mute);
  }
  .cols {
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(2, 1fr);
    background: var(--hairline-soft);
    border: 1px solid var(--hairline-soft);
    border-radius: 6px;
    overflow: hidden;
  }
  .panel {
    background: var(--bg);
    padding: clamp(24px, 2.8vw, 36px);
  }
  .panel h3 {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
