---
import Base from '../layouts/Base.astro';
// Rendered from the repo-root LEGAL.md (single source of truth).
import { Content } from '../../LEGAL.md';

const title = 'Legal Notice — QualiReps';
const description =
  'Publisher, publication director and hosting provider of qualireps.app and the QualiReps application.';
---

<Base title={title} description={description} path="/legal">
  <div class="wrap">
    <article class="prose legal">
      <Content />
    </article>
  </div>
</Base>

<style>
  .legal {
    padding: 2rem 0;
  }
</style>
